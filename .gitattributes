# Line endings: LF in the repository. PowerShell scripts get CRLF in the working copy (LazySpec is a
# Windows PowerShell 5.1 / 7 tool); everything else LF.
* text=auto eol=lf

*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary: never touched
*.exe binary
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.ttf binary
*.otf binary
*.zip binary
