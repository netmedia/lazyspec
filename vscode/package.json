{
  "name": "lazyspec",
  "displayName": "LazySpec - OpenSpec specs and changes",
  "description": "A project's OpenSpec in your editor: the specifications and the plan (by group), formatted reading, tasks, requirements, scenarios and sections to edit, tick, delete or hand to the agent, find, out-of-date documents, undo, validate, archive, and exports for the client in the company look.",
  "version": "0.5.2",
  "publisher": "netmedia",
  "author": {
    "name": "Netmedia",
    "email": "netmedia@netmedia.hr",
    "url": "https://netmedia.agency"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/netmedia/lazyspec",
  "repository": {
    "type": "git",
    "url": "https://github.com/netmedia/lazyspec.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/netmedia/lazyspec/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "openspec",
    "specification",
    "spec-driven",
    "requirements",
    "tasks",
    "lazyspec"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:openspec/config.yaml",
    "workspaceContains:openspec/specs",
    "workspaceContains:openspec/changes",
    "workspaceContains:*/openspec/config.yaml",
    "workspaceContains:*/*/openspec/config.yaml",
    "workspaceContains:*/*/*/openspec/config.yaml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lazyspec",
          "title": "LazySpec",
          "icon": "media/lazyspec.svg"
        }
      ]
    },
    "views": {
      "lazyspec": [
        {
          "id": "lazyspec.plan",
          "name": "Plan"
        },
        {
          "id": "lazyspec.scope",
          "name": "Scope"
        },
        {
          "id": "lazyspec.details",
          "name": "Details",
          "type": "webview"
        },
        {
          "id": "lazyspec.undo",
          "name": "Undo (since the last commit)",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lazyspec.plan",
        "contents": "No openspec folder in this workspace (at its top, or up to three levels below it).\nStart one in the project's root: npm install -g @fission-ai/openspec, then openspec init.\n[Open a folder](command:vscode.openFolder)"
      }
    ],
    "commands": [
      {
        "command": "lazyspec.refresh",
        "title": "Refresh",
        "category": "LazySpec",
        "icon": "$(refresh)"
      },
      {
        "command": "lazyspec.find",
        "title": "Find a Task, Requirement, Scenario or Section",
        "category": "LazySpec",
        "icon": "$(search)"
      },
      {
        "command": "lazyspec.read",
        "title": "Read (Formatted)",
        "category": "LazySpec",
        "icon": "$(book)"
      },
      {
        "command": "lazyspec.readAsOne",
        "title": "Read Changes as One...",
        "category": "LazySpec",
        "icon": "$(files)"
      },
      {
        "command": "lazyspec.readGroups",
        "title": "Read Groups...",
        "category": "LazySpec",
        "icon": "$(layers)"
      },
      {
        "command": "lazyspec.removeBundle",
        "title": "Remove a Saved Whole...",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.newChange",
        "title": "New Change",
        "category": "LazySpec",
        "icon": "$(add)"
      },
      {
        "command": "lazyspec.validate",
        "title": "Validate All",
        "category": "LazySpec",
        "icon": "$(pass)"
      },
      {
        "command": "lazyspec.archive",
        "title": "Archive Change",
        "category": "LazySpec",
        "icon": "$(archive)"
      },
      {
        "command": "lazyspec.sync",
        "title": "Sync Out-of-Date Documents...",
        "category": "LazySpec",
        "icon": "$(warning)"
      },
      {
        "command": "lazyspec.syncAll",
        "title": "Sync All Out-of-Date Changes...",
        "category": "LazySpec",
        "icon": "$(warning)"
      },
      {
        "command": "lazyspec.markInSync",
        "title": "Mark Documents as in Sync",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.export",
        "title": "Export for the Client...",
        "category": "LazySpec",
        "icon": "$(export)"
      },
      {
        "command": "lazyspec.exportLanguage",
        "title": "Export in Another Language...",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.exportItem",
        "title": "Export This...",
        "category": "LazySpec",
        "icon": "$(export)"
      },
      {
        "command": "lazyspec.exportGroups",
        "title": "Export Groups...",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.exportMarkdown",
        "title": "Export Markdown as a Document...",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.editItem",
        "title": "Edit",
        "category": "LazySpec",
        "icon": "$(edit)"
      },
      {
        "command": "lazyspec.editItemInFile",
        "title": "Edit in the File",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.deleteItems",
        "title": "Delete...",
        "category": "LazySpec",
        "icon": "$(trash)"
      },
      {
        "command": "lazyspec.agentItems",
        "title": "The Agent: Change or Write Again...",
        "category": "LazySpec",
        "icon": "$(sparkle)"
      },
      {
        "command": "lazyspec.toggleTask",
        "title": "Task Done / Not Done",
        "category": "LazySpec",
        "icon": "$(check)"
      },
      {
        "command": "lazyspec.readItem",
        "title": "Read Here (Formatted)",
        "category": "LazySpec",
        "icon": "$(book)"
      },
      {
        "command": "lazyspec.agentAnswer",
        "title": "Answer Claude Code (Background Run)...",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.undoRefresh",
        "title": "Refresh",
        "category": "LazySpec",
        "icon": "$(refresh)"
      },
      {
        "command": "lazyspec.undoItem",
        "title": "Undo...",
        "category": "LazySpec",
        "icon": "$(discard)"
      },
      {
        "command": "lazyspec.undoShow",
        "title": "Show the Change",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.showPreview",
        "title": "Show Formatted",
        "category": "LazySpec",
        "icon": "$(open-preview)"
      },
      {
        "command": "lazyspec.showSource",
        "title": "Show Source",
        "category": "LazySpec",
        "icon": "$(go-to-file)"
      },
      {
        "command": "lazyspec.toggleGrouped",
        "title": "Plan: by Group or Flat",
        "category": "LazySpec",
        "icon": "$(list-tree)"
      },
      {
        "command": "lazyspec.toggleArchived",
        "title": "Plan: Show or Hide Archived Changes",
        "category": "LazySpec",
        "icon": "$(archive)"
      },
      {
        "command": "lazyspec.sort",
        "title": "Plan: Sort Changes...",
        "category": "LazySpec",
        "icon": "$(list-ordered)"
      },
      {
        "command": "lazyspec.openTui",
        "title": "Open LazySpec (Terminal UI)",
        "category": "LazySpec",
        "icon": "$(terminal)"
      },
      {
        "command": "lazyspec.openConfig",
        "title": "Open openspec/config.yaml",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.openItem",
        "title": "Open",
        "category": "LazySpec",
        "icon": "$(go-to-file)"
      },
      {
        "command": "lazyspec.showDetails",
        "title": "Show Details",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.help",
        "title": "Help and Keys",
        "category": "LazySpec",
        "icon": "$(question)"
      },
      {
        "command": "lazyspec.openFormatted",
        "title": "Open Formatted Editor",
        "category": "LazySpec",
        "icon": "$(edit)"
      },
      {
        "command": "lazyspec.readFile",
        "title": "Read (LazySpec)",
        "category": "LazySpec",
        "icon": "$(book)"
      },
      {
        "command": "lazyspec.openBlock",
        "title": "Edit in the File",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.focusPlan",
        "title": "Go to the Plan",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.focusScope",
        "title": "Go to the Scope",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.focusDetails",
        "title": "Go to the Details",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.focusUndo",
        "title": "Go to Undo",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.focusEditor",
        "title": "Go to the Open Document",
        "category": "LazySpec"
      },
      {
        "command": "lazyspec.agentOutput",
        "title": "Show Claude Code's Output (Background Run)",
        "category": "LazySpec",
        "icon": "$(output)"
      },
      {
        "command": "lazyspec.agentStop",
        "title": "Stop Claude Code (Background Run)",
        "category": "LazySpec",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lazyspec.syncAll",
          "when": "view == lazyspec.plan && lazyspec.hasStale",
          "group": "navigation@0"
        },
        {
          "command": "lazyspec.find",
          "when": "(view == lazyspec.plan || view == lazyspec.scope)",
          "group": "navigation@1"
        },
        {
          "command": "lazyspec.newChange",
          "when": "view == lazyspec.plan",
          "group": "navigation@2"
        },
        {
          "command": "lazyspec.export",
          "when": "(view == lazyspec.plan || view == lazyspec.scope)",
          "group": "navigation@3"
        },
        {
          "command": "lazyspec.toggleGrouped",
          "when": "view == lazyspec.plan && lazyspec.hasGroups",
          "group": "navigation@4"
        },
        {
          "command": "lazyspec.refresh",
          "when": "(view == lazyspec.plan || view == lazyspec.scope)",
          "group": "navigation@9"
        },
        {
          "command": "lazyspec.validate",
          "when": "(view == lazyspec.plan || view == lazyspec.scope)",
          "group": "1_cli@1"
        },
        {
          "command": "lazyspec.readAsOne",
          "when": "view == lazyspec.plan",
          "group": "2_read@1"
        },
        {
          "command": "lazyspec.readGroups",
          "when": "view == lazyspec.plan && lazyspec.hasGroups",
          "group": "2_read@2"
        },
        {
          "command": "lazyspec.toggleArchived",
          "when": "view == lazyspec.plan",
          "group": "3_view@1"
        },
        {
          "command": "lazyspec.sort",
          "when": "view == lazyspec.plan",
          "group": "3_view@2"
        },
        {
          "command": "lazyspec.exportGroups",
          "when": "view == lazyspec.plan && lazyspec.hasGroups",
          "group": "4_export@1"
        },
        {
          "command": "lazyspec.exportLanguage",
          "when": "(view == lazyspec.plan || view == lazyspec.scope)",
          "group": "4_export@2"
        },
        {
          "command": "lazyspec.removeBundle",
          "when": "view == lazyspec.plan",
          "group": "4_export@3"
        },
        {
          "command": "lazyspec.agentAnswer",
          "when": "(view == lazyspec.plan || view == lazyspec.scope)",
          "group": "5_agent@1"
        },
        {
          "command": "lazyspec.openConfig",
          "when": "(view == lazyspec.plan || view == lazyspec.scope)",
          "group": "6_open@1"
        },
        {
          "command": "lazyspec.openTui",
          "when": "(view == lazyspec.plan || view == lazyspec.scope)",
          "group": "6_open@2"
        },
        {
          "command": "lazyspec.undoRefresh",
          "when": "view == lazyspec.undo",
          "group": "navigation@1"
        },
        {
          "command": "lazyspec.help",
          "when": "view == lazyspec.plan",
          "group": "navigation@10"
        },
        {
          "command": "lazyspec.help",
          "when": "view == lazyspec.scope || view == lazyspec.undo",
          "group": "6_open@3"
        },
        {
          "command": "lazyspec.agentOutput",
          "when": "view == lazyspec.plan",
          "group": "5_agent@2"
        },
        {
          "command": "lazyspec.agentStop",
          "when": "view == lazyspec.plan",
          "group": "5_agent@3"
        }
      ],
      "view/item/context": [
        {
          "command": "lazyspec.sync",
          "when": "viewItem == staleChange",
          "group": "inline@0"
        },
        {
          "command": "lazyspec.read",
          "when": "viewItem =~ /^(change|staleChange|archivedChange|spec|group)$/",
          "group": "inline@1"
        },
        {
          "command": "lazyspec.exportItem",
          "when": "viewItem =~ /^(change|staleChange|archivedChange|spec|group)$/",
          "group": "inline@3"
        },
        {
          "command": "lazyspec.read",
          "when": "viewItem =~ /^(change|staleChange|archivedChange|spec|group)$/",
          "group": "1_open@1"
        },
        {
          "command": "lazyspec.openItem",
          "when": "viewItem =~ /^(change|staleChange|archivedChange|spec)$/",
          "group": "1_open@2"
        },
        {
          "command": "lazyspec.showDetails",
          "when": "viewItem =~ /^(change|staleChange|archivedChange|spec|group)$/",
          "group": "1_open@3"
        },
        {
          "command": "lazyspec.exportItem",
          "when": "viewItem =~ /^(change|staleChange|archivedChange|spec|group)$/",
          "group": "2_export@1"
        },
        {
          "command": "lazyspec.readGroups",
          "when": "viewItem == group",
          "group": "2_export@2"
        },
        {
          "command": "lazyspec.exportGroups",
          "when": "viewItem == group",
          "group": "2_export@3"
        },
        {
          "command": "lazyspec.sync",
          "when": "viewItem == staleChange",
          "group": "3_cli@1"
        },
        {
          "command": "lazyspec.archive",
          "when": "viewItem =~ /^(change|staleChange)$/",
          "group": "3_cli@2"
        },
        {
          "command": "lazyspec.showPreview",
          "when": "viewItem == document",
          "group": "inline@1"
        },
        {
          "command": "lazyspec.showPreview",
          "when": "viewItem == document",
          "group": "1_open@1"
        },
        {
          "command": "lazyspec.showSource",
          "when": "viewItem == document",
          "group": "1_open@2"
        },
        {
          "command": "lazyspec.editItem",
          "when": "viewItem =~ /^item\\./",
          "group": "inline@1"
        },
        {
          "command": "lazyspec.agentItems",
          "when": "viewItem =~ /^item\\./",
          "group": "inline@2"
        },
        {
          "command": "lazyspec.deleteItems",
          "when": "viewItem =~ /^item\\./",
          "group": "inline@3"
        },
        {
          "command": "lazyspec.readItem",
          "when": "viewItem =~ /^item\\./",
          "group": "1_item@1"
        },
        {
          "command": "lazyspec.editItem",
          "when": "viewItem =~ /^item\\./",
          "group": "1_item@2"
        },
        {
          "command": "lazyspec.editItemInFile",
          "when": "viewItem =~ /^item\\./",
          "group": "1_item@3"
        },
        {
          "command": "lazyspec.toggleTask",
          "when": "viewItem == item.task",
          "group": "1_item@4"
        },
        {
          "command": "lazyspec.agentItems",
          "when": "viewItem =~ /^item\\./",
          "group": "2_item@1"
        },
        {
          "command": "lazyspec.deleteItems",
          "when": "viewItem =~ /^item\\./",
          "group": "3_item@1"
        },
        {
          "command": "lazyspec.undoItem",
          "when": "viewItem =~ /^undo(File|Hunk)$/",
          "group": "inline@1"
        },
        {
          "command": "lazyspec.undoItem",
          "when": "viewItem =~ /^undo(File|Hunk)$/",
          "group": "1_undo@1"
        },
        {
          "command": "lazyspec.openFormatted",
          "when": "viewItem == document",
          "group": "1_open@0"
        }
      ],
      "explorer/context": [
        {
          "command": "lazyspec.exportMarkdown",
          "when": "resourceExtname == .md",
          "group": "7_lazyspec@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "lazyspec.exportMarkdown",
          "when": "resourceExtname == .md",
          "group": "7_lazyspec@1"
        }
      ],
      "commandPalette": [
        {
          "command": "lazyspec.archive",
          "when": "false"
        },
        {
          "command": "lazyspec.exportItem",
          "when": "false"
        },
        {
          "command": "lazyspec.openItem",
          "when": "false"
        },
        {
          "command": "lazyspec.showDetails",
          "when": "false"
        },
        {
          "command": "lazyspec.editItem",
          "when": "false"
        },
        {
          "command": "lazyspec.editItemInFile",
          "when": "false"
        },
        {
          "command": "lazyspec.deleteItems",
          "when": "false"
        },
        {
          "command": "lazyspec.agentItems",
          "when": "false"
        },
        {
          "command": "lazyspec.toggleTask",
          "when": "false"
        },
        {
          "command": "lazyspec.readItem",
          "when": "false"
        },
        {
          "command": "lazyspec.undoItem",
          "when": "false"
        },
        {
          "command": "lazyspec.undoShow",
          "when": "false"
        },
        {
          "command": "lazyspec.undoRefresh",
          "when": "false"
        },
        {
          "command": "lazyspec.markInSync",
          "when": "false"
        },
        {
          "command": "lazyspec.exportMarkdown",
          "when": "resourceExtname == .md"
        },
        {
          "command": "lazyspec.openBlock",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "lazyspec.openFormatted",
          "when": "resourceExtname == .md && !(activeCustomEditorId == lazyspec.formatted)",
          "group": "navigation@-10"
        },
        {
          "submenu": "lazyspec.mdOptions",
          "when": "resourceExtname == .md",
          "group": "navigation@-9"
        }
      ],
      "lazyspec.mdOptions": [
        {
          "command": "lazyspec.openFormatted",
          "group": "1_open@1"
        },
        {
          "command": "lazyspec.showSource",
          "group": "1_open@2"
        },
        {
          "command": "lazyspec.showPreview",
          "group": "1_open@3"
        },
        {
          "command": "lazyspec.readFile",
          "group": "2_read@1"
        },
        {
          "command": "lazyspec.exportMarkdown",
          "group": "3_export@1"
        },
        {
          "command": "lazyspec.help",
          "group": "9_help@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lazyspec.find",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "lazyspec.deleteItems",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "(focusedView == lazyspec.plan || focusedView == lazyspec.scope)"
      },
      {
        "command": "lazyspec.editItem",
        "key": "f2",
        "when": "(focusedView == lazyspec.plan || focusedView == lazyspec.scope)"
      },
      {
        "command": "lazyspec.toggleTask",
        "key": "space",
        "when": "(focusedView == lazyspec.plan || focusedView == lazyspec.scope)"
      },
      {
        "command": "lazyspec.agentItems",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "(focusedView == lazyspec.plan || focusedView == lazyspec.scope)"
      },
      {
        "command": "lazyspec.read",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "(focusedView == lazyspec.plan || focusedView == lazyspec.scope)"
      },
      {
        "command": "lazyspec.undoItem",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == lazyspec.undo"
      },
      {
        "command": "lazyspec.focusPlan",
        "key": "ctrl+; p",
        "mac": "cmd+; p"
      },
      {
        "command": "lazyspec.focusScope",
        "key": "ctrl+; s",
        "mac": "cmd+; s"
      },
      {
        "command": "lazyspec.focusDetails",
        "key": "ctrl+; d",
        "mac": "cmd+; d"
      },
      {
        "command": "lazyspec.focusUndo",
        "key": "ctrl+; u",
        "mac": "cmd+; u"
      },
      {
        "command": "lazyspec.focusEditor",
        "key": "ctrl+; e",
        "mac": "cmd+; e"
      }
    ],
    "configuration": {
      "title": "LazySpec",
      "properties": {
        "lazyspec.script": {
          "type": "string",
          "default": "",
          "markdownDescription": "LazySpec's `lazyspec.ps1` for export and the terminal UI. Empty: the project's own (`tools/lazyspec/lazyspec.ps1`), else the one in this extension."
        },
        "lazyspec.powershell": {
          "type": "string",
          "default": "",
          "markdownDescription": "The PowerShell to run it with. Empty: `powershell.exe` on Windows, `pwsh` elsewhere (PowerShell 7: https://aka.ms/powershell)."
        },
        "lazyspec.openspec": {
          "type": "string",
          "default": "openspec",
          "markdownDescription": "The OpenSpec CLI (`npm install -g @fission-ai/openspec`): validate, archive, new change."
        },
        "lazyspec.roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Projects with an `openspec` folder deeper than the workspace's folders (paths relative to a workspace folder, e.g. `apps/portal`). Without it, a folder with no `openspec` at its top gets the ones up to three levels below it."
        },
        "lazyspec.openOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Opening a folder with an openspec folder (code . there) shows LazySpec's sidebar: the Plan, the Scope, the details."
        },
        "lazyspec.showArchived": {
          "type": "boolean",
          "default": false,
          "description": "The plan shows archived changes too."
        },
        "lazyspec.grouped": {
          "type": "boolean",
          "default": true,
          "description": "The plan by group (in projects that group their changes)."
        },
        "lazyspec.documents": {
          "type": "string",
          "enum": [
            "formatted",
            "preview",
            "source"
          ],
          "enumDescriptions": [
            "Formatted, to edit (bold, headings, lists, tables from a bar on top)",
            "Formatted, read-only (the Markdown preview)",
            "The Markdown itself"
          ],
          "default": "formatted",
          "description": "A document clicked in the Plan or the Scope opens in the formatted editor, the preview or as its source (the title bar's buttons switch)."
        },
        "lazyspec.sort": {
          "type": "string",
          "enum": [
            "name",
            "name-desc",
            "recent"
          ],
          "default": "name",
          "description": "The plan's changes: by name A-Z, Z-A, or recently modified first."
        },
        "lazyspec.editor": {
          "type": "string",
          "enum": [
            "formatted",
            "source"
          ],
          "enumDescriptions": [
            "The item alone in the formatted editor (Save / Cancel)",
            "Its lines selected in the Markdown"
          ],
          "default": "formatted",
          "description": "Edit on a task, requirement, scenario or section: in the formatted editor, or in the Markdown itself."
        },
        "lazyspec.openMarkdownFormatted": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open openspec's Markdown files (`**/openspec/**/*.md`) in the formatted editor wherever they are opened from (the Explorer, `Ctrl+P`, links): LazySpec sets `workbench.editorAssociations` in your user settings (and takes it out again when this is off). **Source** in the title bar's LazySpec menu opens the Markdown itself."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "lazyspec.formatted",
        "displayName": "LazySpec: Formatted Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "submenus": [
      {
        "id": "lazyspec.mdOptions",
        "label": "LazySpec",
        "icon": "$(list-selection)"
      }
    ]
  },
  "scripts": {
    "kit": "node scripts/copy-kit.js",
    "compile": "npm run kit && tsc -p . && node scripts/bundle-webview.js",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/model.test.js out/test/ops.test.js out/test/mdmerge.test.js",
    "test:vscode": "npm run compile && node out/test/run-vscode.js",
    "package": "npm run compile && vsce package --no-dependencies -o lazyspec.vsix"
  },
  "devDependencies": {
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
